{
  "description": "Règles personnalisées d'extraction et de filtrage par dépôt pour les Payloads (.elf / .bin)",
  "category_icons": {
    "ps5_activation": "🔓",
    "ps5_cheat": "🏴‍☠️",
    "ps5_dns": "🌐",
    "ps5_file_explorer": "📂",
    "ps5_freeshop": "💾",
    "ps5_game_dump": "💿",
    "ps5_hen_loader": "🚀",
    "ps5_kstuff": "🧪",
    "ps5_linux": "🐧",
    "ps5_saves": "📝",
    "ps5_sdk_debug": "⚙️",
    "ps5_server": "🖥️",
    "ps5_themes": "🎨",
    "ps5_trophy": "🏆",
    "ps5_utility": "🛠️"
  },
  "rules": [
    {
      "id": "poords4_rule",
      "repo": "poords4",
      "extension_ignore": [".dmg", ".exe", ".appimage", ".msi", ".txt"],
      "keyword_ignore": ["PS4"],
      "archive_extract": true,
      "archive_target_extension": [".elf"],
      "force_rename": false,
      "custom_filename": "",
      "multiple_files": true,
      "special_rules": "extract_zip_and_keep_base_names"
    },
    {
      "id": "fan_target_rule",
      "repo": "fan_target",
      "extension_ignore": [".zip", ".txt"],
      "keyword_ignore": ["PS4"],
      "archive_extract": true,
      "archive_target_extension": [".elf"],
      "force_rename": true,
      "custom_filename": "fan_target_{temp_match}",
      "multiple_files": true,
      "special_rules": "extract_temperature_suffix"
    },
    {
      "id": "psm_poop2jb_rule",
      "repo": "instalador-host-psm-poop2jb",
      "extension_ignore": [".dmg", ".exe", ".txt"],
      "keyword_ignore": ["PS4"],
      "archive_extract": true,
      "archive_target_extension": [".elf"],
      "force_rename": false,
      "custom_filename": "",
      "multiple_files": true,
      "special_rules": "keep_original_binary_names"
    },
    {
      "id": "websrv_strict_rule",
      "repo": "ps5-payload-dev/websrv",
      "extension_ignore": [".zip", ".dmg", ".exe", ".appimage", ".msi", ".txt", ".md"],
      "keyword_ignore": ["PS4"],
      "archive_extract": false,
      "archive_target_extension": [".elf", ".bin"],
      "force_rename": false,
      "custom_filename": "",
      "multiple_files": false,
      "special_rules": "strict_binary_only"
    },
    {
      "id": "ps5upload_strict_rule",
      "repo": "phantomptr/ps5upload",
      "extension_ignore": [".zip", ".dmg", ".exe", ".txt"],
      "keyword_ignore": ["PS4"],
      "archive_extract": false,
      "archive_target_extension": [".elf"],
      "force_rename": false,
      "custom_filename": "",
      "multiple_files": false,
      "special_rules": "strict_binary_only"
    },
    {
      "id": "seregonwar_zftpd_rule",
      "repo": "seregonwar/zftpd",
      "extension_ignore": [".zip", ".txt", ".md"],
      "keyword_ignore": ["ps4"],
      "archive_extract": false,
      "archive_target_extension": [".elf"],
      "force_rename": true,
      "custom_filename": "",
      "multiple_files": true,
      "special_rules": "zftpd_ps5_mapping",
      "file_mappings": [
        {
          "pattern": "zftpd-ps5-v*.elf",
          "target_name": "zftp_v1.0.5.elf"
        },
        {
          "pattern": "zftpd-ps5-zhttp-v*.elf",
          "target_name": "zhttp_v1.5.0.elf"
        }
      ]
    }
  ]
}