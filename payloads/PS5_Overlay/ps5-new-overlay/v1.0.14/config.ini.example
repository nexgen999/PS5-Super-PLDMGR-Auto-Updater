# =======================================================
# PS5 Hardware Overlay Configuration
# Place this file on your PS5 at:
# /data/ps5_overlay/config.ini
# =======================================================

[ps5_overlay]

# Enable or disable the overlay daemon
enabled = true

# Screen position for 2D bar: "top" or "bottom"
position = top

# Show real-time in-game FPS counter (Hardware scanout / DCE)
show_fps = true

# Show CPU temperature (Celsius)
show_cpu_temp = true

# Show CPU utilization percentage
show_cpu_load = true

# Show per-core CPU load instead of overall average
show_all_cores = false

# Show GPU / APU SoC temperature (Celsius)
show_gpu_temp = true

# Show VRAM usage percentage
show_gpu_load = true

# Show system RAM usage (e.g. 4.8 / 16.0 GB (30%))
show_ram = true

# Show cooling fan duty cycle percentage
show_fan = true

# Display a translucent background bar behind HUD text
background = true

# Font size in points (default: 18)
font_size = 18

# Hardware sensors polling interval in milliseconds (default: 1000 = 1s)
interval_ms = 1000

# In-game notification toasts (optional, default: false)
# When false, only 1 startup toast is sent and no notifications interrupt gameplay.
toast_notifications = false

# Interval between toast updates in seconds (if toast_notifications is manually set to true)
toast_interval_sec = 10

# Embedded real-time Web HUD server (true/false)
# Accessible via http://<PS5_IP>:8080/ on phone, PC, or PS5 "Pin to Side"
web_server = true

# Port for Web HUD server (default: 8080)
web_port = 8080
